# ============================================================
# DATA. The directories (data/raw/, data/processed/) are
# tracked via .gitkeep files; their contents are not. GitHub
# rejects any file exceeding 100 MB, and a smaller file
# committed in error remains in the repository history after
# deletion. Raw and derived data reside on the cluster and on
# local disk, and must never be committed to this repository.
# ============================================================
data/*
data
!data/*/
!data/**/.gitkeep
*.nc
*.nc4
*.csv
*.parquet
*.zarr/
*.grib
*.grib2
*.h5
*.hdf5

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
*.egg

# uv and venv directories are never committed; these comprise
# approximately 1 GB of platform-specific binaries.
.venv/
venv/
uv-cache/

# ============================================================
# FRONTEND (JavaScript/TypeScript)
# ============================================================
# frontend/public/data/ holds the exported visualisation bundle -- manifest
# JSON, GeoJSON tracks and raw float32 field files, regenerated by
# sar.viz.export whenever a different window is wanted. The DATA block above
# does not catch it: *.json and *.geojson are not listed there, and deliberately
# so, since package.json and friends must stay tracked. Without this line a
# 2 MB bundle is committed by accident, and every regeneration of it stays in
# history forever. The bundle belongs on object storage, not in git (D021).
frontend/public/data/
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.turbo/
*.log

# Playwright's own output. `test-results/` holds traces, videos and failure
# screenshots and runs to tens of MB per failing run; `playwright-report/` is
# the HTML viewer for it. Both are regenerated by the next run and neither is
# evidence of anything once the run is over. The config keeps them small
# (video and trace off, screenshots only on failure), but a default
# `playwright test --trace on` from a command line would not, so they are
# ignored rather than trusted to stay small.
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# The E2E fixture store is the ONE Zarr directory that must be tracked, and
# the DATA block above ignores `*.zarr/` everywhere. It is a few hundred kB of
# deliberately fake field over a handful of frames, and it exists so the
# browser suite runs offline and deterministically -- which means it has to be
# in the repository or CI has no data and the suite silently tests nothing.
# The negation is scoped to this one path so it cannot become a door for real
# data: anything real is orders of magnitude larger and lives on Hugging Face.
!frontend/tests/e2e/fixtures/
!frontend/tests/e2e/fixtures/**
npm-debug.log*
yarn-debug.log*
.eslintcache

# ============================================================
# FIGURES. figures/report/ is tracked, comprising small,
# deliverable figures indexed in FIGURES.md. figures/reference/
# is not tracked, comprising reference imagery not owned by the
# project (for example, Zoom Earth screenshots).
# ============================================================
figures/reference/*
!figures/reference/.gitkeep

# ============================================================
# CREDENTIALS. The cluster password, API keys and similar
# material must be communicated out of band, and must never be
# stored within this repository.
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# ============================================================
# OPERATING SYSTEM AND EDITOR
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Notebooks checkpoints & OS junk
.ipynb_checkpoints/
.DS_Store

# LaTeX build junk (if the paper lives in the repo)
*.aux
*.log
*.bbl
*.blg
*.out
*.synctex.gz
